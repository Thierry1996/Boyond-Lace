# Beyond Lace — environment contract (locked stack, Phase 7).
# Copy to .env.local for development. Production values live in Vercel secrets.

# Relational database — Prisma Postgres via the node-postgres (pg) adapter.
# `npx prisma postgres link --database <id>` writes DATABASE_URL into .env
# (a plain postgres:// string). The Prisma CLI + src/lib/db.ts read it.
DATABASE_URL=

# Supabase — storefront read data (collections; products later).
# The publishable key is public by design (RLS-guarded); safe in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth — Clerk (managed). Keys from the Clerk dashboard (dashboard.clerk.com).
# Auth is DORMANT until the publishable key is present: the storefront works
# with these blank, and sign-in/up + the admin console activate once set.
# Configure OAuth providers (Google, GitHub, etc.) in the Clerk dashboard, not here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk's hosted UI lives (defaults shown; the app also uses these routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Payments (Phase 3 — Stripe primary; PayPal/Alipay methods configured in Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI (Phase 5 — Claude via Vercel AI SDK)
ANTHROPIC_API_KEY=

# Assets (Phase 1/2 — Vercel Blob)
BLOB_READ_WRITE_TOKEN=

