# Beyond Lace — environment contract (locked stack, Phase 7).
# Copy to .env.local for development. Production values live in Vercel secrets.

# Relational database — Prisma Postgres via the node-postgres (pg) adapter.
# `npx prisma postgres link --database <id>` writes DATABASE_URL into .env
# (a plain postgres:// string). The Prisma CLI + src/lib/db.ts read it.
DATABASE_URL=

# Supabase — storefront read data (collections; products later).
# The publishable key is public by design (RLS-guarded); safe in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth — Better Auth (replaces Clerk). Its user/session/account/verification
# tables live on a SEPARATE Postgres (Neon) so Prisma's declarative migrations
# never touch them. Falls back to DATABASE_URL if unset.
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Optional GitHub OAuth — only registered when both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payments (Phase 3 — Stripe primary; PayPal/Alipay methods configured in Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI (Phase 5 — Claude via Vercel AI SDK)
ANTHROPIC_API_KEY=

# Assets (Phase 1/2 — Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Neon Auth (PARKED — Clerk is the active provider; see src/lib/neon-auth.ts)
NEXT_PUBLIC_NEON_AUTH_URL=
